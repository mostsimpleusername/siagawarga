# SiagaWarga - Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya

# ============================================================
# DATABASE
# ============================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
# Untuk Supabase Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/siaga_warga

# ============================================================
# SECURITY
# ============================================================
# Generate dengan: openssl rand -hex 32
SECRET_KEY=ganti-dengan-secret-key-yang-kuat-di-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# APP URLS & CORS
# ============================================================
APP_NAME=SiagaWarga
APP_VERSION=1.0.0
DEBUG=False
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true jika ingin tautan verifikasi disimulasikan & dimunculkan pada respon JSON registrasi (hanya untuk dev/testing lokal)
EXPOSE_VERIFICATION_LINK=false

# ============================================================
# EMAIL SERVICE (Default: Brevo API)
# ============================================================
# Pilihan EMAIL_PROVIDER: "brevo", "resend", "smtp", atau "console" (simulasi di log)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=noreply@siagawarga.id
MAIL_FROM_NAME=SiagaWarga

# Konfigurasi SMTP lama (hanya digunakan jika EMAIL_PROVIDER=smtp)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ============================================================
# AI SERVICE
# ============================================================
# Hosted secara terpisah (misal di Railway, Render, VPS)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30
