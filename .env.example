# SiagaWarga - Environment Variables
# Salin file ini menjadi .env dan isi nilainya

# ============================================================
# DATABASE
# ============================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/siaga_warga

# ============================================================
# SECURITY
# ============================================================
# Generate dengan: openssl rand -hex 32
SECRET_KEY=ganti-dengan-secret-key-yang-kuat-di-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# APP
# ============================================================
APP_NAME=SiagaWarga
APP_VERSION=1.0.0
DEBUG=False

# ============================================================
# SMTP / EMAIL
# ============================================================
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@siagawarga.id
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
